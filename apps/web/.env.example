# URL interna da API (servidor → servidor). O navegador nunca acessa esta URL.
API_URL=http://localhost:3001/api/v1
# Segredo de 32+ caracteres para criptografar o cookie de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32-caracteres
# Inatividade máxima da sessão, em minutos
SESSION_IDLE_MINUTES=30
