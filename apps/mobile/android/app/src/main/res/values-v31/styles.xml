<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: tela de abertura nativa com o símbolo do Laço -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/laco_fundo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:statusBarColor">@color/laco_fundo</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/laco_fundo</item>
    </style>
</resources>
