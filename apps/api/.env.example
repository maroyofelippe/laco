# Copie para .env (ou rode `npm run keys`, que cria o arquivo e gera as chaves JWT).
NODE_ENV=development
PORT=3001
# Origem do painel web (CORS). O app Android não usa CORS.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# MySQL instalado localmente (8.0+, recomendado 8.4 LTS). Sem Docker.
# `npm run db:setup` cria os bancos e os usuários abaixo e preenche as senhas vazias.
# Somente a API conhece estas credenciais; o app e o painel nunca acessam o banco.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# Linux/macOS: opcional, conecta pelo socket em vez de TCP (ex.: /var/run/mysqld/mysqld.sock ou /tmp/mysql.sock)
DB_SOCKET=
DB_NAME=laco
DB_TEST_NAME=laco_test
# Usuário da API: somente SELECT/INSERT/UPDATE/DELETE
DB_USER=laco_app
DB_PASSWORD=
# Usuário de migrações/testes/backup: DDL nos dois bancos
DB_MIGRATION_USER=laco_migrator
DB_MIGRATION_PASSWORD=
# TLS para o MySQL: obrigatório fora da máquina local
DB_SSL=false
# Opcional: caminhos de mysql/mysqldump se não estiverem no PATH (usados por db:backup/db:restore)
# MYSQL_CLIENT_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
BACKUP_KEEP=14

# JWT ES256 (gerado por `npm run keys`)
JWT_ISSUER=laco-api
JWT_AUDIENCE=laco
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

LOG_LEVEL=info
# Pasta dos arquivos enviados (extratos e fotos de notas). Fora do Git; inclua no backup.
STORAGE_DIR=./storage
# Prefixo do campo `type` dos erros. Troque pela URL de documentação quando o domínio oficial existir.
PROBLEM_TYPE_BASE=urn:laco:erro:
