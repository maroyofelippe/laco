{
  "name": "@laco/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Laço (NestJS + MySQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "keys": "node scripts/gen-keys.mjs",
    "db:setup": "ts-node scripts/db-setup.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register src/db/migrate.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/db/seed.ts",
    "db:reset": "ts-node -r tsconfig-paths/register src/db/migrate.ts --reset && npm run db:seed",
    "openapi:export": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "lint": "tsc --noEmit",
    "test": "jest --config test/jest-e2e.json --runInBand",
    "db:doctor": "ts-node scripts/db-doctor.ts",
    "db:backup": "ts-node scripts/db-backup.ts",
    "db:restore": "ts-node scripts/db-restore.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.4.7",
    "helmet": "8.1.0",
    "jose": "5.10.0",
    "kysely": "0.28.2",
    "mysql2": "3.14.1",
    "nestjs-pino": "4.4.0",
    "pdfjs-dist": "^3.11.174",
    "pino-http": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.1",
    "@types/jest": "29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "13.0.0",
    "supertest": "7.1.0",
    "ts-jest": "29.3.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3"
  }
}
